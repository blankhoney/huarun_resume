# Default: keep repository private unless a file is explicitly allowed.
*

# Allow directory traversal for whitelist rules below.
!*/

# Keep the ignore policy itself shareable.
!.gitignore

# Public GitHub files.
!README.md
!README.*.md
!readme.md
!readme.*.md

# Selected technical, operations, and requirements documentation.
!docs/
!docs/TECHNICAL*.md
!docs/technical/
!docs/technical/**/*.md
!docs/OPERATIONS*.md
!docs/operations/
!docs/operations/**/*.md
!docs/ops/
!docs/ops/**/*.md
!docs/REQUIREMENTS*.md
!docs/requirements/
!docs/requirements/**/*.md
!docs/product/
!docs/product/**/*.md

# Public app source for the interview MVP.
!pyproject.toml
!.dockerignore
!Dockerfile
!docker-compose.yml
!Caddyfile
!src/
!src/**/*.py
!src/**/*.html
!tests/
!tests/**/*.py
!assets/
!assets/**/*.css
!assets/**/*.js

# Explicit local/private files and agent state.
.env
.env.*
AGENTS.md
AGENT.md
agent.md
agents.md
.agents/
.codex/
.claude/
.cursor/
.mcp.json

# Common generated or dependency output.
node_modules/
dist/
build/
.next/
.cache/
coverage/
.worktrees/
.venv/
.pytest_cache/
__pycache__/
*.egg-info/
*.pyc
*.log
uploads/
screenshots/
*.sqlite3
